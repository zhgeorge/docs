  "keyFeatures": [
    "Request for Quote (RFQ) crypto trading with firm quotes",
    "Central Limit Order Book (CLOB) for real-time price-time priority matching",
    "Stablecoin and crypto payins and payouts",
    "ACH/Plaid-powered fiat on-ramp and off-ramp",
    "Drop-in SDKs for KYC onboarding, trading, deposits, and withdrawals",
    "Settlements-as-a-Service for off-exchange and OTC trade clearing",
    "Native crypto staking via API",
    "Crypto rewards and loyalty programs",
    "Virtual accounts and sub-accounts per end user",
    "Comprehensive reporting suite via portal and API",
    "Regulatory compliance umbrella (FinCEN MSB, money transmitter in all 50 states)",
    "Real-time balances WebSocket feed",
    "Sanction screening and KYC-as-a-Service"
  ],
  "publicApiSurface": [
    "GET /time — health check / server timestamp",
    "POST /liquidity/rfq — request a quote",
    "POST /liquidity/execute — execute a quote",
    "POST /participants — create a participant",
    "GET /participants/{participant_code} — retrieve participant",
    "POST /accounts — create an account",
    "GET /accounts — list accounts with balances",
    "POST /deposits — initiate a deposit",
    "POST /withdrawals — initiate a withdrawal",
    "POST /transfers — transfer between accounts",
    "POST /trades — submit a trade (CLOB)",
    "POST /orders — submit a limit/market order",
    "POST /rewards — issue crypto reward",
    "POST /staking/stakes — initiate a staking position",
    "DELETE /staking/stakes/{id} — unstake",
    "GET /staking/rewards — get staking rewards",
    "GET /balances — get platform/participant balances",
    "WebSocket: Balances Feed",
    "WebSocket: Prices Feed"
  ]
}
